{
  "name": "aidcp-kernel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "aidcp 云端三服务的共享契约层：纯类型 / 接口 / 常量 / 纯函数。禁含 SQL、HTTP、LLM 供应商标识符、模块级 Set/Map。",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    "./*.js": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "tsc -p tsconfig.json",
    "test": "npm run build && tsx --test 'test/**/*.test.ts' 'test/**/*.test.mjs'",
    "test:scheduled-catalog": "npm run build && node --test test/scheduled-automation-catalog.test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2",
    "tsx": "^4.19.2",
    "@types/pg": "^8.11.10"
  },
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "pg": "^8.13.1"
  }
}
